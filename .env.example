# Copy to .env.local for local development, and set the same variables on your host.

# Public origin used for canonical URLs, sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://avenstudio.se

# Contact form delivery via Resend (https://resend.com).
# Without these, enquiries are logged to the terminal in development
# and the form shows an error in production.
RESEND_API_KEY=
# Inbox that receives enquiries (comma-separate several addresses).
CONTACT_TO_EMAIL=aavenstudio@gmail.com
# Sender on a domain verified in Resend, e.g. "Aven Studio <forfragan@avenstudio.se>".
CONTACT_FROM_EMAIL=
